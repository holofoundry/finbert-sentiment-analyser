pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string(
            name: 'GIT_BRANCH',
            defaultValue: 'main',
            description: 'Git branch to deploy.'
        )
        string(
            name: 'GITHUB_CREDENTIALS_ID',
            defaultValue: 'github-pat-token',
            description: 'Jenkins username/password GitHub PAT credential used for repo checkout.'
        )
        string(
            name: 'DEPLOY_HOST',
            defaultValue: '100.102.25.32',
            description: 'SSH host for the Jetson Orin Nano server.'
        )
        string(
            name: 'DEPLOY_PATH',
            defaultValue: '/opt/finbert',
            description: 'Root deployment directory on the remote host. Repo cloned into DEPLOY_PATH/finbert-sentiment-analyser.'
        )
        string(
            name: 'SSH_CREDENTIALS_ID',
            defaultValue: 'jetson-deployment-key',
            description: 'Jenkins SSH private key credential used to connect to the remote server.'
        )
        string(
            name: 'SERVICE_PORT',
            defaultValue: '8000',
            description: 'Port that uvicorn will bind to on the remote host.'
        )
        booleanParam(
            name: 'FORCE_REINSTALL',
            defaultValue: false,
            description: 'When true, deletes and recreates the virtual environment from scratch.'
        )
    }

    environment {
        REPOSITORY_URL = 'https://github.com/holofoundry/finbert-sentiment-analyser.git'
        PYTHON_VERSION = '3.11.15'
        SERVICE_NAME   = 'finbert'
        SERVICE_USER   = 'finbert'
        SERVICE_GROUP  = 'finbert'
    }

    stages {

        // ------------------------------------------------------------------ //
        stage('Checkout') {
        // ------------------------------------------------------------------ //
            steps {
                script {
                    env.DEPLOY_GITHUB_CREDENTIALS_ID = params.GITHUB_CREDENTIALS_ID?.trim() ?: 'github-pat-token'
                }
                deleteDir()
                git branch: "${params.GIT_BRANCH}",
                    credentialsId: "${env.DEPLOY_GITHUB_CREDENTIALS_ID}",
                    url: "${env.REPOSITORY_URL}"
            }
        }

        // ------------------------------------------------------------------ //
        stage('Prepare') {
        // ------------------------------------------------------------------ //
        // Resolve parameters and write all remote shell scripts into the
        // Jenkins workspace.  Scripts are scp'd and executed in later stages —
        // no complex SSH heredocs needed.
        // ------------------------------------------------------------------ //
            steps {
                script {
                    env.DEPLOY_WEB_HOST        = params.DEPLOY_HOST?.trim()          ?: '100.102.25.32'
                    env.DEPLOY_REMOTE_ROOT     = params.DEPLOY_PATH?.trim()          ?: '/opt/finbert'
                    env.DEPLOY_SSH_CREDS_ID    = params.SSH_CREDENTIALS_ID?.trim()   ?: 'jetson-deployment-key'
                    env.DEPLOY_SERVICE_PORT    = params.SERVICE_PORT?.trim()         ?: '8000'
                    env.DEPLOY_APP_DIR         = "${env.DEPLOY_REMOTE_ROOT}/finbert-sentiment-analyser"
                    env.DEPLOY_VENV_DIR        = "${env.DEPLOY_APP_DIR}/.venv"
                    env.DEPLOY_FORCE_REINSTALL = params.FORCE_REINSTALL ? 'true' : 'false'

                    sh 'mkdir -p remote-scripts'

                    // ── Script 1: Bootstrap pyenv + Python 3.11 ───────────
                    writeFile file: 'remote-scripts/01_bootstrap.sh', text: '''#!/usr/bin/env bash
set -euo pipefail

echo "=== [bootstrap] Installing system build dependencies ==="
sudo apt-get update -qq
sudo apt-get install -y -qq \
    build-essential curl git \
    libssl-dev zlib1g-dev libbz2-dev \
    libreadline-dev libsqlite3-dev libncursesw5-dev \
    xz-utils tk-dev libxml2-dev libxmlsec1-dev \
    libffi-dev liblzma-dev ca-certificates

echo "=== [bootstrap] Checking pyenv ==="
PYENV_ROOT_DIR="$HOME/.pyenv"
if [ ! -d "$PYENV_ROOT_DIR" ]; then
    echo "[bootstrap] Installing pyenv..."
    curl -fsSL https://pyenv.run | bash
else
    echo "[bootstrap] pyenv already present at $PYENV_ROOT_DIR"
fi

export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - bash)"

echo "=== [bootstrap] Ensuring pyenv is in .bashrc ==="
PROFILE="$HOME/.bashrc"
if ! grep -q "pyenv init" "$PROFILE" 2>/dev/null; then
    echo "[bootstrap] Adding pyenv block to $PROFILE..."
    printf "\\n# pyenv - added by finbert Jenkins deploy\\n"          >> "$PROFILE"
    printf 'export PYENV_ROOT="$HOME/.pyenv"\\n'                      >> "$PROFILE"
    printf 'export PATH="$PYENV_ROOT/bin:$PATH"\\n'                   >> "$PROFILE"
    printf 'eval "$(pyenv init - bash)"\\n'                           >> "$PROFILE"
else
    echo "[bootstrap] pyenv already in $PROFILE"
fi

echo "=== [bootstrap] Checking Python $PYENV_VERSION ==="
if pyenv versions --bare 2>/dev/null | grep -qx "$PYENV_VERSION"; then
    echo "[bootstrap] Python $PYENV_VERSION already installed."
else
    echo "[bootstrap] Installing Python $PYENV_VERSION (may take several minutes)..."
    pyenv install "$PYENV_VERSION"
    echo "[bootstrap] Python $PYENV_VERSION installed."
fi

echo "=== [bootstrap] Complete ==="
'''

                    // ── Script 2: Clone / update repo ─────────────────────
                    // REPO_URL is injected at runtime (contains credentials)
                    writeFile file: 'remote-scripts/02_clone.sh', text: '''#!/usr/bin/env bash
set -euo pipefail

: "${DEPLOY_ROOT:?DEPLOY_ROOT must be set}"
: "${APP_DIR:?APP_DIR must be set}"
: "${BRANCH:?BRANCH must be set}"
: "${REPO_URL:?REPO_URL must be set}"
: "${SVC_USER:?SVC_USER must be set}"
: "${SVC_GROUP:?SVC_GROUP must be set}"

echo "=== [clone] Ensuring deploy root $DEPLOY_ROOT exists ==="
sudo mkdir -p "$DEPLOY_ROOT"

if ! id "$SVC_USER" &>/dev/null; then
    echo "[clone] Creating system user $SVC_USER..."
    sudo useradd --system --home "$DEPLOY_ROOT" --shell /usr/sbin/nologin "$SVC_USER"
fi
sudo chown -R "$SVC_USER":"$SVC_GROUP" "$DEPLOY_ROOT"

echo "=== [clone] Clone / update repo ==="
if [ -d "$APP_DIR/.git" ]; then
    echo "[clone] Repo exists — fetching latest..."
    sudo -u "$SVC_USER" git -C "$APP_DIR" remote set-url origin "$REPO_URL"
    sudo -u "$SVC_USER" git -C "$APP_DIR" fetch --prune origin
    sudo -u "$SVC_USER" git -C "$APP_DIR" checkout "$BRANCH"
    sudo -u "$SVC_USER" git -C "$APP_DIR" reset --hard "origin/$BRANCH"
else
    echo "[clone] Fresh clone into $APP_DIR..."
    sudo -u "$SVC_USER" git clone --branch "$BRANCH" "$REPO_URL" "$APP_DIR"
fi

echo "=== [clone] Repo at branch $BRANCH is ready ==="
'''

                    // ── Script 3: Virtual environment + dependencies ───────
                    writeFile file: 'remote-scripts/03_venv.sh', text: '''#!/usr/bin/env bash
set -euo pipefail

: "${APP_DIR:?APP_DIR must be set}"
: "${VENV_DIR:?VENV_DIR must be set}"
: "${PYENV_VERSION:?PYENV_VERSION must be set}"
: "${FORCE_REINSTALL:?FORCE_REINSTALL must be set}"
: "${SVC_USER:?SVC_USER must be set}"

PYENV_PYTHON="$HOME/.pyenv/versions/$PYENV_VERSION/bin/python3.11"

echo "=== [venv] Locating Python binary ==="
if [ ! -f "$PYENV_PYTHON" ]; then
    echo "[venv] ERROR: Expected binary not found at $PYENV_PYTHON"
    echo "[venv] Run Bootstrap stage first."
    exit 1
fi
echo "[venv] Using: $PYENV_PYTHON"

if [ "$FORCE_REINSTALL" = "true" ] && [ -d "$VENV_DIR" ]; then
    echo "[venv] FORCE_REINSTALL=true — removing $VENV_DIR..."
    sudo rm -rf "$VENV_DIR"
fi

if [ ! -d "$VENV_DIR" ]; then
    echo "=== [venv] Creating virtual environment ==="
    sudo -u "$SVC_USER" "$PYENV_PYTHON" -m venv "$VENV_DIR"
fi

echo "=== [venv] Upgrading pip toolchain ==="
sudo -u "$SVC_USER" "$VENV_DIR/bin/pip" install --upgrade pip setuptools wheel

echo "=== [venv] Installing application dependencies ==="
# torch is intentionally omitted — the Jetson has a GPU-optimised build
# pre-installed. Installing via pip would overwrite it with a CPU-only wheel.
sudo -u "$SVC_USER" "$VENV_DIR/bin/pip" install \
    fastapi "uvicorn[standard]" pydantic \
    transformers safetensors \
    scikit-learn numpy pandas

if [ -f "$APP_DIR/requirements.txt" ]; then
    echo "=== [venv] Installing from requirements.txt ==="
    sudo -u "$SVC_USER" "$VENV_DIR/bin/pip" install -r "$APP_DIR/requirements.txt"
fi

echo "=== [venv] Done ==="
'''

                    // ── Script 4: systemd service ──────────────────────────
                    writeFile file: 'remote-scripts/04_systemd.sh', text: '''#!/usr/bin/env bash
set -euo pipefail

: "${APP_DIR:?APP_DIR must be set}"
: "${VENV_DIR:?VENV_DIR must be set}"
: "${SERVICE_PORT:?SERVICE_PORT must be set}"
: "${DEPLOY_ROOT:?DEPLOY_ROOT must be set}"
: "${SVC_NAME:?SVC_NAME must be set}"
: "${SVC_USER:?SVC_USER must be set}"
: "${SVC_GROUP:?SVC_GROUP must be set}"

SERVICE_FILE="/etc/systemd/system/${SVC_NAME}.service"

echo "=== [systemd] Writing $SERVICE_FILE ==="

# Write the unit file in parts to avoid heredoc-within-heredoc issues
sudo tee "$SERVICE_FILE" > /dev/null << UNIT_EOF
[Unit]
Description=FinBERT Sentiment API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${SVC_USER}
Group=${SVC_GROUP}
WorkingDirectory=${APP_DIR}
Environment=PATH=${VENV_DIR}/bin
ExecStart=${VENV_DIR}/bin/uvicorn app:app --host 0.0.0.0 --port ${SERVICE_PORT}
Restart=on-failure
RestartSec=5
Environment=HF_HOME=${DEPLOY_ROOT}/.cache/huggingface
Environment=TRANSFORMERS_CACHE=${DEPLOY_ROOT}/.cache/huggingface

[Install]
WantedBy=multi-user.target
UNIT_EOF

echo "=== [systemd] Reloading daemon and enabling service ==="
sudo systemctl daemon-reload
sudo systemctl enable "${SVC_NAME}.service"

if sudo systemctl is-active --quiet "${SVC_NAME}.service"; then
    echo "[systemd] Restarting running service..."
    sudo systemctl restart "${SVC_NAME}.service"
else
    echo "[systemd] Starting service for the first time..."
    sudo systemctl start "${SVC_NAME}.service"
fi

echo "[systemd] Waiting 10s for service to settle..."
sleep 10

STATUS=$(sudo systemctl is-active "${SVC_NAME}.service" || true)
echo "[systemd] Service status: $STATUS"

if [ "$STATUS" != "active" ]; then
    echo "=== ERROR: Service failed to start. Last 50 journal lines: ==="
    sudo journalctl -u "${SVC_NAME}.service" -n 50 --no-pager
    exit 1
fi

echo "=== [systemd] ${SVC_NAME}.service is active on port ${SERVICE_PORT} ==="
'''

                    // ── Script 5: Smoke test ───────────────────────────────
                    writeFile file: 'remote-scripts/05_smoke.sh', text: '''#!/usr/bin/env bash
set -euo pipefail

: "${SERVICE_PORT:?SERVICE_PORT must be set}"
: "${SVC_NAME:?SVC_NAME must be set}"

HEALTH_URL="http://127.0.0.1:${SERVICE_PORT}/health"
echo "=== [smoke] Polling $HEALTH_URL (up to 60 s) ==="

for i in $(seq 1 12); do
    CODE=$(curl -s -o /dev/null -w "%{http_code}" "$HEALTH_URL" || true)
    if [ "$CODE" = "200" ]; then
        echo "[smoke] Health check passed (HTTP 200) after $((i * 5))s."
        exit 0
    fi
    echo "[smoke] Attempt $i/12 — HTTP $CODE, waiting 5s..."
    sleep 5
done

echo "=== ERROR: /health did not return 200 within 60s ==="
sudo journalctl -u "${SVC_NAME}.service" -n 50 --no-pager
exit 1
'''

                }
            }
        }

        // ------------------------------------------------------------------ //
        stage('Bootstrap Remote: pyenv + Python 3.11') {
        // ------------------------------------------------------------------ //
            steps {
                script {
                    def sshCredId = params.SSH_CREDENTIALS_ID?.trim() ?: 'jetson-deployment-key'
                    def deployHost = params.DEPLOY_HOST?.trim() ?: '100.102.25.32'
                    
                    withCredentials([sshUserPrivateKey(
                        credentialsId: sshCredId,
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )]) {
                        sh """
                            echo "[jenkins] Copying bootstrap script to remote..."
                            scp -i "\$SSH_KEY" -o StrictHostKeyChecking=no -o BatchMode=yes \
                                remote-scripts/01_bootstrap.sh \
                                "\$SSH_USER@${deployHost}:/tmp/finbert_01_bootstrap.sh"

                            echo "[jenkins] Executing bootstrap script..."
                            ssh -i "\$SSH_KEY" -o StrictHostKeyChecking=no -o BatchMode=yes \
                                "\$SSH_USER@${deployHost}" \
                                "chmod +x /tmp/finbert_01_bootstrap.sh && PYENV_VERSION=${env.PYTHON_VERSION} bash /tmp/finbert_01_bootstrap.sh"
                        """
                    }
                }
            }
        }

        // ------------------------------------------------------------------ //
        stage('Deploy: Clone / Update Repo') {
        // ------------------------------------------------------------------ //
            steps {
                script {
                    def sshCredId = params.SSH_CREDENTIALS_ID?.trim() ?: 'jetson-deployment-key'
                    def githubCredId = params.GITHUB_CREDENTIALS_ID?.trim() ?: 'github-pat-token'
                    def deployHost = params.DEPLOY_HOST?.trim() ?: '100.102.25.32'
                    def deployPath = params.DEPLOY_PATH?.trim() ?: '/opt/finbert'
                    def gitBranch = params.GIT_BRANCH?.trim() ?: 'main'
                    def appDir = "${deployPath}/finbert-sentiment-analyser"

                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: sshCredId,
                            keyFileVariable: 'SSH_KEY',
                            usernameVariable: 'SSH_USER'
                        ),
                        usernamePassword(
                            credentialsId: githubCredId,
                            usernameVariable: 'GIT_USER',
                            passwordVariable: 'GIT_TOKEN'
                        )
                    ]) {
                        sh """
                            echo "[jenkins] Copying clone script to remote..."
                            scp -i "\$SSH_KEY" -o StrictHostKeyChecking=no -o BatchMode=yes \
                                remote-scripts/02_clone.sh \
                                "\$SSH_USER@${deployHost}:/tmp/finbert_02_clone.sh"

                            echo "[jenkins] Executing clone script..."
                            ssh -i "\$SSH_KEY" -o StrictHostKeyChecking=no -o BatchMode=yes \
                                "\$SSH_USER@${deployHost}" \
                                "chmod +x /tmp/finbert_02_clone.sh && \\
                                 DEPLOY_ROOT='${deployPath}' \\
                                 APP_DIR='${appDir}' \\
                                 BRANCH='${gitBranch}' \\
                                 REPO_URL='https://\$GIT_USER:\$GIT_TOKEN@github.com/holofoundry/finbert-sentiment-analyser.git' \\
                                 SVC_USER='${env.SERVICE_USER}' \\
                                 SVC_GROUP='${env.SERVICE_GROUP}' \\
                                 bash /tmp/finbert_02_clone.sh"
                        """
                    }
                }
            }
        }

        // ------------------------------------------------------------------ //
        stage('Deploy: Virtual Environment + Dependencies') {
        // ------------------------------------------------------------------ //
            steps {
                script {
                    def sshCredId = params.SSH_CREDENTIALS_ID?.trim() ?: 'jetson-deployment-key'
                    def deployHost = params.DEPLOY_HOST?.trim() ?: '100.102.25.32'
                    def deployPath = params.DEPLOY_PATH?.trim() ?: '/opt/finbert'
                    def appDir = "${deployPath}/finbert-sentiment-analyser"
                    def venvDir = "${appDir}/.venv"
                    def forceReinstall = params.FORCE_REINSTALL ? 'true' : 'false'

                    withCredentials([sshUserPrivateKey(
                        credentialsId: sshCredId,
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )]) {
                        sh """
                            echo "[jenkins] Copying venv script to remote..."
                            scp -i "\$SSH_KEY" -o StrictHostKeyChecking=no -o BatchMode=yes \
                                remote-scripts/03_venv.sh \
                                "\$SSH_USER@${deployHost}:/tmp/finbert_03_venv.sh"

                            echo "[jenkins] Executing venv script..."
                            ssh -i "\$SSH_KEY" -o StrictHostKeyChecking=no -o BatchMode=yes \
                                "\$SSH_USER@${deployHost}" \
                                "chmod +x /tmp/finbert_03_venv.sh && \\
                                 APP_DIR='${appDir}' \\
                                 VENV_DIR='${venvDir}' \\
                                 PYENV_VERSION='${env.PYTHON_VERSION}' \\
                                 FORCE_REINSTALL='${forceReinstall}' \\
                                 SVC_USER='${env.SERVICE_USER}' \\
                                 bash /tmp/finbert_03_venv.sh"
                        """
                    }
                }
            }
        }

        // ------------------------------------------------------------------ //
        stage('Deploy: systemd Service') {
        // ------------------------------------------------------------------ //
            steps {
                script {
                    def sshCredId = params.SSH_CREDENTIALS_ID?.trim() ?: 'jetson-deployment-key'
                    def deployHost = params.DEPLOY_HOST?.trim() ?: '100.102.25.32'
                    def deployPath = params.DEPLOY_PATH?.trim() ?: '/opt/finbert'
                    def appDir = "${deployPath}/finbert-sentiment-analyser"
                    def venvDir = "${appDir}/.venv"
                    def servicePort = params.SERVICE_PORT?.trim() ?: '8000'

                    withCredentials([sshUserPrivateKey(
                        credentialsId: sshCredId,
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )]) {
                        sh """
                            echo "[jenkins] Copying systemd script to remote..."
                            scp -i "\$SSH_KEY" -o StrictHostKeyChecking=no -o BatchMode=yes \
                                remote-scripts/04_systemd.sh \
                                "\$SSH_USER@${deployHost}:/tmp/finbert_04_systemd.sh"

                            echo "[jenkins] Executing systemd script..."
                            ssh -i "\$SSH_KEY" -o StrictHostKeyChecking=no -o BatchMode=yes \
                                "\$SSH_USER@${deployHost}" \
                                "chmod +x /tmp/finbert_04_systemd.sh && \\
                                 APP_DIR='${appDir}' \\
                                 VENV_DIR='${venvDir}' \\
                                 SERVICE_PORT='${servicePort}' \\
                                 DEPLOY_ROOT='${deployPath}' \\
                                 SVC_NAME='${env.SERVICE_NAME}' \\
                                 SVC_USER='${env.SERVICE_USER}' \\
                                 SVC_GROUP='${env.SERVICE_GROUP}' \\
                                 bash /tmp/finbert_04_systemd.sh"
                        """
                    }
                }
            }
        }

        // ------------------------------------------------------------------ //
        stage('Smoke Test') {
        // ------------------------------------------------------------------ //
            steps {
                script {
                    def sshCredId = params.SSH_CREDENTIALS_ID?.trim() ?: 'jetson-deployment-key'
                    def deployHost = params.DEPLOY_HOST?.trim() ?: '100.102.25.32'
                    def servicePort = params.SERVICE_PORT?.trim() ?: '8000'

                    withCredentials([sshUserPrivateKey(
                        credentialsId: sshCredId,
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )]) {
                        sh """
                            echo "[jenkins] Copying smoke test script to remote..."
                            scp -i "\$SSH_KEY" -o StrictHostKeyChecking=no -o BatchMode=yes \
                                remote-scripts/05_smoke.sh \
                                "\$SSH_USER@${deployHost}:/tmp/finbert_05_smoke.sh"

                            echo "[jenkins] Running smoke test..."
                            ssh -i "\$SSH_KEY" -o StrictHostKeyChecking=no -o BatchMode=yes \
                                "\$SSH_USER@${deployHost}" \
                                "chmod +x /tmp/finbert_05_smoke.sh && \\
                                 SERVICE_PORT='${servicePort}' \\
                                 SVC_NAME='${env.SERVICE_NAME}' \\
                                 bash /tmp/finbert_05_smoke.sh"
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo """
=======================================================
  FinBERT native deployment completed successfully.
  Host   : ${env.DEPLOY_WEB_HOST}
  AppDir : ${env.DEPLOY_APP_DIR}
  Port   : ${env.DEPLOY_SERVICE_PORT}
  Service: ${env.SERVICE_NAME}.service (systemd)
=======================================================
"""
        }
        failure {
            echo "Deployment failed. Check the stage logs above for details."
        }
    }
}
